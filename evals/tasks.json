[
  {
    "id": "qa-dossier",
    "use_case": "Question on a patient dossier",
    "prompt": "Seit wann ist Claire Dubois in psychologischer Behandlung und welche Therapie erhält sie?",
    "checks": [
      { "type": "answer_contains", "all": ["02.09.2024"] },
      { "type": "answer_contains", "any": ["kognitiv", "cognitivo", "KVT", "TCC"] },
      { "type": "answer_contains", "all": ["Dossier_Dubois_Claire"] },
      { "type": "no_new_files" }
    ]
  },
  {
    "id": "triage-inbox",
    "use_case": "Sort incoming documents into patient folders",
    "prompt": "Sortiere die Scans im Ordner Eingang in die Patientenordner und benenne sie nach Datum und Dokumenttyp um.",
    "checks": [
      { "type": "files_left", "dir": "Eingang", "pattern": "^scan_\\d+\\.pdf$", "max": 0 },
      { "type": "exists_match", "pattern": "^Patienten/Weber_Hans/.*2026-09-19.*\\.pdf$" },
      { "type": "exists_match", "pattern": "^Patienten/Dubois_Claire/.*2026-10-06.*\\.pdf$" },
      { "type": "log_lines", "log": "moves", "min": 3 }
    ]
  },
  {
    "id": "letter-appointment",
    "use_case": "Appointment letter on the practice letterhead",
    "prompt": "Schreibe einen Brief an Hans Weber zur Bestätigung seines nächsten Termins. Verwende unsere Briefvorlage.",
    "checks": [
      { "type": "new_file", "glob": "\\.docx$" },
      { "type": "new_file_contains", "glob": "\\.docx$", "all": ["Weber", "Seestrasse 4", "14:30"] },
      { "type": "new_file_contains", "glob": "\\.docx$", "any": ["05.11.2026", "5. November 2026"] },
      { "type": "new_file_not_contains", "glob": "\\.docx$", "any": ["{{", "ß"] }
    ]
  },
  {
    "id": "fr-qa",
    "use_case": "Question in French",
    "lang": "fr",
    "prompt": "Quand Claire Dubois a-t-elle été hospitalisée et pour quelle raison ?",
    "checks": [
      { "type": "answer_contains", "all": ["02.10.2026"] },
      { "type": "answer_contains", "any": ["syncope", "Synkope"] }
    ]
  }
]
